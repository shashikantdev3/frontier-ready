<figure class="figure figure--accounts">
<svg class="figure__wide" viewBox="0 0 680 340" role="img" aria-labelledby="acc-t acc-d">
  <title id="acc-t">How your accounts connect</title>
  <desc id="acc-d">You sign in to LevelUp with your Partner Skilling Hub account. Your exam results go from Pearson VUE to your Microsoft Learn profile. In Partner Center you make two links: one to your Skilling Hub profile, and one to your Microsoft Learn profile after your first exam.</desc>
  <defs>
    <marker id="acc-a" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path class="arrow" d="M0,0 L10,5 L0,10 z"/></marker>
    <marker id="acc-r" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path class="arrow--link" d="M0,0 L10,5 L0,10 z"/></marker>
  </defs>

  <path class="edge edge--link" d="M105,50 V24 H575 V148" marker-end="url(#acc-r)"/>
  <text class="edge-label" x="340" y="17" text-anchor="middle">link 1: your Skilling Hub profile</text>
  <path class="edge edge--link" d="M425,285 H575 V222" marker-end="url(#acc-r)"/>
  <text class="edge-label" x="500" y="304" text-anchor="middle">link 2: after</text>
  <text class="edge-label" x="500" y="318" text-anchor="middle">your first exam</text>

  <path class="edge" d="M190,85 H252" marker-end="url(#acc-a)"/>
  <text class="small" x="222" y="78" text-anchor="middle">sign in</text>
  <path class="edge" d="M190,285 H252" marker-end="url(#acc-a)"/>
  <text class="small" x="222" y="278" text-anchor="middle">results</text>

  <rect class="box" x="20" y="50" width="170" height="70" rx="2"/>
  <text class="label" x="34" y="80">Skilling Hub</text>
  <text class="small" x="34" y="100">sign up with work email</text>

  <rect class="box" x="255" y="50" width="170" height="70" rx="2"/>
  <text class="label" x="269" y="80">LevelUp</text>
  <text class="small" x="269" y="100">courses and assessments</text>

  <rect class="box" x="20" y="250" width="170" height="70" rx="2"/>
  <text class="label" x="34" y="280">Pearson VUE</text>
  <text class="small" x="34" y="300">you sit the three exams</text>

  <rect class="box" x="255" y="250" width="170" height="70" rx="2"/>
  <text class="label" x="269" y="280">Microsoft Learn</text>
  <text class="small" x="269" y="300">personal + work account</text>

  <rect class="box box--key" x="490" y="150" width="170" height="70" rx="2"/>
  <text class="label" x="504" y="180">Partner Center</text>
  <text class="small" x="504" y="200">your company's record</text>
</svg>

<svg class="figure__narrow" viewBox="0 0 360 620" role="img" aria-labelledby="acc-tn acc-dn">
  <title id="acc-tn">How your accounts connect</title>
  <desc id="acc-dn">You sign in to LevelUp with your Partner Skilling Hub account. Your exam results go from Pearson VUE to your Microsoft Learn profile. In Partner Center you make two links: one to your Skilling Hub profile, and one to your Microsoft Learn profile after your first exam.</desc>
  <defs>
    <marker id="acc-an" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path class="arrow" d="M0,0 L10,5 L0,10 z"/></marker>
    <marker id="acc-rn" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path class="arrow--link" d="M0,0 L10,5 L0,10 z"/></marker>
  </defs>

  <path class="edge edge--link" d="M230,52 H330 V572 H233" marker-end="url(#acc-rn)"/>
  <text class="edge-label" x="236" y="44">link 1</text>
  <path class="edge edge--link" d="M120,464 V537" marker-end="url(#acc-rn)"/>
  <text class="edge-label" x="130" y="497">link 2: after your</text>
  <text class="edge-label" x="130" y="511">first exam</text>

  <path class="edge" d="M120,84 V127" marker-end="url(#acc-an)"/>
  <text class="small" x="130" y="110">sign in</text>
  <path class="edge" d="M120,364 V397" marker-end="url(#acc-an)"/>
  <text class="small" x="130" y="385">results</text>

  <rect class="box" x="20" y="20" width="210" height="64" rx="2"/>
  <text class="label" x="34" y="47">Skilling Hub</text>
  <text class="small" x="34" y="67">sign up with work email</text>

  <rect class="box" x="20" y="130" width="210" height="64" rx="2"/>
  <text class="label" x="34" y="157">LevelUp</text>
  <text class="small" x="34" y="177">courses and assessments</text>

  <rect class="box" x="20" y="300" width="210" height="64" rx="2"/>
  <text class="label" x="34" y="327">Pearson VUE</text>
  <text class="small" x="34" y="347">you sit the three exams</text>

  <rect class="box" x="20" y="400" width="210" height="64" rx="2"/>
  <text class="label" x="34" y="427">Microsoft Learn</text>
  <text class="small" x="34" y="447">personal + work account</text>

  <rect class="box box--key" x="20" y="540" width="210" height="64" rx="2"/>
  <text class="label" x="34" y="567">Partner Center</text>
  <text class="small" x="34" y="587">your company's record</text>
</svg>
<figcaption>Two separate tracks meet in Partner Center. Courses and assessments come in through the Skilling Hub. Exams come in through Microsoft Learn. Miss either link, and that half of your work doesn't count for your company.</figcaption>
</figure>
